{
  "$schema": "https://opencode.ai/config.json",
  // Academic workspace — overrides global config
  // MCPs tuned for research & paper writing
  "mcp": {
    "zotero": {
      "type": "local",
      "command": ["zotero-mcp"],
      "environment": {
        "ZOTERO_LOCAL": "true"
      },
      "enabled": true
    },
    "alphaxiv": {
      "type": "remote",
      "url": "https://api.alphaxiv.org/mcp/v1",
      "enabled": true
    },
    "semantic-scholar": {
      "enabled": true
    },
    // Disable non-academic MCPs
    "ssh-mcp": {
      "enabled": false
    },
    "ticktick": {
      "enabled": false
    }
  }
}
