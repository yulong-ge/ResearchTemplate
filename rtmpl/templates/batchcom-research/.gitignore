.DS_Store
node_modules/
.opencode/node_modules/
.rk/state/
.pytest_cache/
.uv-cache/
.venv/
*.egg-info/
__pycache__/
**/__pycache__/
*.log
*.tmp

# Experiment tracking local caches (metadata lives in W&B cloud)
wandb/
mlruns/

# Large model / checkpoint / tensor artifacts — never commit; live in RESULTS_ROOT
*.pt
*.pth
*.ckpt
*.safetensors
*.bin
*.npy
*.npz
*.h5
*.arrow

# Local secrets / per-machine overrides
.env
.env.*
*.local
config.local.*

# Notebook checkpoints
.ipynb_checkpoints/

# rtmpl internals — state files (config.yaml, state.json) ARE tracked; these are not
.rtmpl/.backup-*/
.rtmpl/*.tmp
.rtmpl/.lock
.rtmpl/.pending
*.new
